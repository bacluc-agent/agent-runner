# OpenWebUI / AISIX Configuration
# Copy this file to .env and fill in your API keys

# OpenCode API keys (3 subscriptions for failover)
OPENCODE_API_KEY=
OPENCODE_API_KEY_2=
OPENCODE_API_KEY_3=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Requesty API key
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Cortecs API key
CORTECS_API_KEY=
CORTECS_BASE_URL=https://api.cortecs.ai/v1

# OpenWebUI caller key (used by OpenWebUI to call AISIX)
OPENWEBUI_CALLER_KEY=

# Model configuration (override in local.py or .env)
ZEN_MODEL_CHAT=deepseek-v4-flash
ZEN_MODEL_CHAT_THINKING=deepseek-v4-pro
ZEN_MODEL_WEB_RESEARCH=qwen3.8-flash
ZEN_MODEL_FAST=mimo-v2.6-flash
REQUESTY_MODEL_CHAT=novita/deepseek/deepseek-v3.2
CORTECS_MODEL_CHAT=glm-5.3-flash

# Brave API key for SearXNG web search
BRAVE_API_KEY=