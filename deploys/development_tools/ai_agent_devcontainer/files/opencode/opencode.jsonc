{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["github-copilot"],
  "permission": {
    "*": "allow"
  },
  "plugin": [
    // renovate: datasource=npm depName=@dietrichgebert/ponytail
    "@dietrichgebert/ponytail@4.9.0",
    // renovate: datasource=npm depName=opencode-gemini-auth
    "opencode-gemini-auth@1.4.15",
    // renovate: datasource=npm depName=bacluc-opencode-completion-check-command
    "bacluc-opencode-completion-check-command@0.9.7",
    // renovate: datasource=npm depName=opencode-auto-resume
    "opencode-auto-resume@1.1.13",
    // renovate: datasource=github-tags depName=obra/superpowers
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "default_agent": "coordinator",
  "agent": {
    "build": {
      "mode": "all"
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1"
      },
      "models": {
        "gpt-oss:20b-mmap": {
          "name": "gpt-oss:20b-mmap"
        },
        "qwen2.5:3b": {
          "name": "qwen2.5:3b"
        },
        "qwen2.5:3b-mmap": {
          "name": "qwen2.5:3b-mmap"
        },
        "ministral-3:3b": {
          "name": "ministral-3:3b"
        },
        "mistral:7b-mmap": {
          "name": "mistral:7b-mmap"
        },
        "gpt-oss:20b": {
          "name": "gpt-oss:20b"
        },
        "mistral:7b": {
          "name": "mistral:7b"
        },
        "gemma4:31b": {
          "name": "gemma4:31b"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna"
        }
      }
    },
    "opencode-go-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "opencode-go-anthropic",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1/messages",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "minimax-m2.7": {
          "name": "minimax-m2.7"
        },
        "minimax-m2.5": {
          "name": "minimax-m2.5"
