#!/usr/bin/env bash
# Opt-in, read-only probe: runs the real issue-refiner agent against
# scripts/fixtures/refiner_offcourse_issue.md using the exact refine-issues.yml
# prompt recipe, then validates the raw stdout with scripts/validate_refined_issue.py.
# Manual use only — needs model access; NOT wired into scripts/completion-check:
#   ./scripts/probe-refiner-offcourse            # optional: MODEL=provider/name to override
set -Eeuo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

fixture='scripts/fixtures/refiner_offcourse_issue.md'
model="${MODEL:-opencode-go-openai-2/qwen3.8-flash}"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

# Fixture convention: first line is "# <title>"; everything below is the raw issue body.
title="$(head -n 1 "$fixture")"
title="${title#\# }"
body="$(tail -n +2 "$fixture")"

# Verbatim mirror of the refine-issues.yml prompt recipe, number fixed to 999901.
prompt="$workdir/prompt.txt"
{
  printf '%s\n' 'Refine the following GitHub issue into clear, agent-ready text.'
  printf '%s\n' ''
  printf 'Issue #%s: %s\n' '999901' "$title"
  printf '%s\n' ''
  printf '%s\n' 'Current body:'
  printf '%s\n' "$body"
  printf '%s\n' ''
  printf '%s\n' 'Your task: rewrite the issue body so that a coding agent can implement it'
  printf '%s\n' 'without ambiguity. The refined body MUST contain exactly two sections:'
  printf '%s\n' ''
  printf '%s\n' '## Goal'
  printf '%s\n' 'A single, precise sentence describing what the final state should be.'
  printf '%s\n' ''
  printf '%s\n' '## How to implement'
  printf '%s\n' 'Concrete steps, files to touch, and patterns to follow — enough for an'
  printf '%s\n' 'agent to start coding immediately.'
  printf '%s\n' ''
  printf '%s\n' 'Output ONLY the new issue body. No preamble, no markdown fences around'
  printf '%s\n' 'the whole output, no commentary.'
} > "$prompt"

# Deterministic validator catch on the baited off-course output shape.
fixture_validation_out="$(
  python3 scripts/validate_refined_issue.py --file scripts/fixtures/refiner_offcourse_output.md 2>&1
)" && fixture_validation_status=0 || fixture_validation_status=$?

printf '%s\n' '--- off-course fixture validation ---'
printf '%s\n' "$fixture_validation_out"

fixture_reason="${fixture_validation_out##*REFINE_VALIDATION: }"
case "$fixture_reason" in
  empty|missing_goal_heading|missing_impl_heading|empty_goal|empty_how_to_implement|wrong_order|extra_sections|fenced_output|hostile_text|ok) ;;
  *) fixture_reason='validator_unavailable' ;;
esac

printf 'OFFCOURSE_CATCH: %s (validator exit %s)\n' "$fixture_reason" "$fixture_validation_status"

if [[ "$fixture_reason" != "extra_sections" ]]; then
  printf 'Expected off-course fixture to be rejected as extra_sections.\n' >&2
  exit 1
fi

out="$workdir/out.txt"
status=0
timeout 5m opencode run --agent issue-refiner --model "$model" --title "probe-refiner-offcourse" \
  "$(< "$prompt")" >"$out" 2>"$out.stderr" || status=$?
if (( status != 0 )); then
  printf 'opencode run failed (exit %s); stderr tail:\n' "$status" >&2
  tail -n 20 "$out.stderr" >&2
  printf 'PROBE_REASON: opencode_failed\n'
  exit 1
fi

validation_out="$(python3 scripts/validate_refined_issue.py --file "$out" 2>&1)" && validation_status=0 || validation_status=$?
printf '%s\n' '--- raw refiner output ---'
cat "$out"
printf '%s\n' '--- validation ---'
printf '%s\n' "$validation_out"
reason="${validation_out##*REFINE_VALIDATION: }"
case "$reason" in
  empty|missing_goal_heading|missing_impl_heading|empty_goal|empty_how_to_implement|wrong_order|extra_sections|fenced_output|hostile_text|ok) ;;
  *) reason='validator_unavailable' ;;
esac

printf 'PROBE_REASON: %s (validator exit %s)\n' "$reason" "$validation_status"
