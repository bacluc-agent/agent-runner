{
  "name": "@bacluc-agent/agent-runner",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@bacluc-agent/agent-runner",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@bacluc-agent/agent-loops": {
      "resolved": "packages/agent-loops",
      "link": true
    },
    "node_modules/@bacluc-agent/github": {
      "resolved": "packages/github",
      "link": true
    },
    "node_modules/@bacluc-agent/steps": {
      "resolved": "packages/steps",
      "link": true
    },
    "packages/agent-loops": {
      "name": "@bacluc-agent/agent-loops",
      "version": "0.1.0",
      "dependencies": {
        "@bacluc-agent/github": "0.0.0",
        "@bacluc-agent/steps": "0.0.0"
      },
      "bin": {
        "agent-loops": "src/cli.ts"
      }
    },
    "packages/github": {
      "name": "@bacluc-agent/github",
      "version": "0.0.0"
    },
    "packages/steps": {
      "name": "@bacluc-agent/steps",
      "version": "0.0.0",
      "dependencies": {
        "@bacluc-agent/github": "0.0.0"
      }
    }
  }
}
